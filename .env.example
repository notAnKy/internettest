# Server-only. Copy to .env.local; never prefix either with NEXT_PUBLIC_.
# Metered > TURN Server > Credentials > Get credential > Show API Key
# App name accepts the prefix or full <app>.metered.live domain under Developers.
# Use the credential-specific API key, never the Developers Secret key.
METERED_APP_NAME=your_app_name
METERED_TURN_API_KEY=your_credential_api_key
